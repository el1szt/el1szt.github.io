<header id="masthead" class="site-header" role="banner">
    <hgroup>
      <h1 class="site-title">
        <a href="<%- url_for() %>" title="<%= config.title %>" rel="home"><%= config.title %></a>
      </h1>
      <% var description = theme.subtitle || config.description || config.subtitle; %>
      <% if (description){ %>
        <p class="site-description" id="subtitle"><%= description %></p>
      <% } %>
    </hgroup>

    <nav id="site-navigation" class="main-navigation" role="navigation" aria-label="主导航">
            <button class="menu-toggle" type="button" aria-controls="menu-main" aria-expanded="false">菜单</button>
            <a class="assistive-text" href="#content" title="跳至内容">跳至内容</a>
            <div class="menu-main-container">
                <ul id="menu-main" class="nav-menu">
                <% for (var i in theme.menu){ %>
                    <li class="menu-item menu-item-type-post_type menu-item-object-page"><a href="<%- url_for(theme.menu[i]) %>"><%= i %></a></li>
                <% } %>
                </ul>
            </div>
    </nav>
</header>
